{
  "expo": {
    "name": "Tokito Music",
    "slug": "tokito-music",
    "version": "1.0.0",
    "scheme": "tokitomusic",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fa0d37fe-5f87-4665-9099-b9a057f7fb94"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Tokito Music to access your microphone.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-splash-screen",
      "expo-status-bar",
      "expo-font",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tokito.music"
    },
    "android": {
      "package": "com.tokito.music",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa0d37fe-5f87-4665-9099-b9a057f7fb94"
      }
    },
    "owner": "t4tokito"
  }
}
